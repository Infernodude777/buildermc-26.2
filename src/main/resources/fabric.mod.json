{
	"schemaVersion": 1,
	"id": "buildermc",
	"version": "${version}",
	"name": "BuilderMC",
	"description": "A construction-themed Minecraft mod adding building tools, measuring tape, and a builder's workbench.",
	"authors": [
		"infernodude777"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/buildermc",
		"sources": "https://github.com/infernodude777/buildermc"
	},
	"license": "MIT",
	"icon": "assets/buildermc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.infernodude777.buildermc.BuilderMC"
		],
		"fabric-datagen": [
			"net.infernodude777.buildermc.BuilderMCDataGenerator"
		]
	},
	"mixins": [
		"buildermc.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
